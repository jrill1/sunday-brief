# Copy to .env, fill in, then:  chmod 600 .env
# .env is git-ignored and lives on each machine separately (laptop + Mini).
# Read by python-dotenv at runtime.

# --- Pushover (required to send) ---
PUSHOVER_TOKEN=
PUSHOVER_USER=

# --- Your calendars (start here) ---
# Google Calendar → Settings → pick calendar → Integrate calendar →
# "Secret address in iCal format". Paste those URLs here.
ICAL_ME_WORK=
ICAL_ME_PERSONAL=

# --- Spouse's calendars (add later) ---
# ICAL_SPOUSE_WORK=
# ICAL_SPOUSE_PERSONAL=

# --- Optional: narrative summaries ---
# ANTHROPIC_API_KEY=

# Set to 1 to read secrets from the macOS Keychain instead (see README).
SUNDAYBRIEF_USE_KEYCHAIN=0
