# Copy to .env, fill in, then:  chmod 600 .env
# .env is git-ignored and lives on each machine separately (laptop + Mini).
# Read by python-dotenv at runtime.

# --- Pushover (required to send) ---
PUSHOVER_TOKEN=
PUSHOVER_USER=

# --- Your calendars (start here) ---
# Google Calendar → Settings → pick calendar → Integrate calendar →
# "Secret address in iCal format". Paste those URLs here.
ICAL_ME_WORK=
ICAL_ME_PERSONAL=

# --- Spouse's calendars (add later) ---
# ICAL_SPOUSE_WORK=
# ICAL_SPOUSE_PERSONAL=

# --- Optional: narrative summaries ---
# ANTHROPIC_API_KEY=

# --- Closure-email drop-box (for closures.run_extract --source imap) ---
# A dedicated Gmail account you forward school emails to. Needs 2-Step
# Verification turned on, then an App Password generated at
# myaccount.google.com/apppasswords (use that 16-char password here, NOT the
# account's real password). Read-only usage — the code only ever fetches.
DROPBOX_IMAP_USER=
DROPBOX_IMAP_PASSWORD=
# Only set this if the drop-box isn't Gmail (default: imap.gmail.com):
# DROPBOX_IMAP_HOST=

# Set to 1 to read secrets from the macOS Keychain instead (see README).
SUNDAYBRIEF_USE_KEYCHAIN=0
