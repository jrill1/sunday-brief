# Copy to .env, fill in, then:  chmod 600 .env
# .env is git-ignored and lives on each machine separately (laptop + Mini).
# Read by python-dotenv at runtime.

# --- Pushover (required to send) ---
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Optional: a second recipient (e.g. your spouse's Pushover user key) who
# gets the weekly brief too. Ledger spotchecks (below) always stay
# single-recipient, regardless of this.
# PUSHOVER_USER_SPOUSE=

# Optional: a separate Pushover Application (its own token, from
# pushover.net/apps/build) just for ledger spotchecks (below), so they land
# in their own thread instead of the weekly brief's. Falls back to
# PUSHOVER_TOKEN if unset.
# PUSHOVER_TOKEN_LEDGER=

# --- Your calendars (start here) ---
# Google Calendar → Settings → pick calendar → Integrate calendar →
# "Secret address in iCal format". Paste those URLs here.
ICAL_ME_WORK=
ICAL_ME_PERSONAL=

# --- Spouse's calendars (add later) ---
# ICAL_SPOUSE_WORK=
# ICAL_SPOUSE_PERSONAL=

# --- Optional: narrative summaries ---
# ANTHROPIC_API_KEY=

# Optional: kids' names/ages, used for age-appropriate picks and narrative
# phrasing ("Max (4y) and Priya (1y 7mo)"). A JSON array of
# {"name", "age_months", "as_of"} — age is computed fresh from age_months as
# of that reference date, so it never needs manual updating. Omit entirely
# if you'd rather the brief just say "the kids".
# CHILDREN_JSON=[{"name": "Max", "age_months": 30, "as_of": "2026-01-01"}]

# --- Closure-email drop-box (for closures.run_extract --source imap) ---
# A dedicated Gmail account you forward school emails to. Needs 2-Step
# Verification turned on, then an App Password generated at
# myaccount.google.com/apppasswords (use that 16-char password here, NOT the
# account's real password). Read-only usage — the code only ever fetches.
DROPBOX_IMAP_USER=
DROPBOX_IMAP_PASSWORD=
# Only set this if the drop-box isn't Gmail (default: imap.gmail.com):
# DROPBOX_IMAP_HOST=

# Set to 1 to read secrets from the macOS Keychain instead (see README).
SUNDAYBRIEF_USE_KEYCHAIN=0
